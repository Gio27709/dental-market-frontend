VITE_API_URL=https://dental-market-backend.onrender.com/api
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Client ID (Web) del OAuth de Google, el mismo que está en Supabase > Auth > Providers > Google.
# Con él se usa el botón oficial de Google; sin él, la redirección por Supabase.
VITE_GOOGLE_CLIENT_ID=

# Microsoft Clarity (grabaciones y mapas de calor). Solo se carga en builds de producción.
# Vacío en local. En el VPS va en .env.production.
VITE_CLARITY_ID=

# Botón flotante «Escríbenos» por WhatsApp. Solo dígitos con código de país (58 para
# Venezuela), p. ej. 584121234567. Vacío = el botón no se muestra.
VITE_WHATSAPP_NUMBER=
